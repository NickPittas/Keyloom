; CorridorKey Windows installer (Inno Setup 6). Rendered by packaging/bundle.py; do not edit the output.
; Per-user by default (no admin, no service, no firewall rule, no listener). Each version lands in
; {app}\versions\<id>; lifecycle.py validates it, switches the active version, writes the Start Menu
; shortcut + receipt and (optionally) runs the shared model manager. User data lives outside {app}.
#define VID "@VERSION_ID@"

[Setup]
AppId={{7C1E6C52-3B0F-4D5A-9E57-2D6C7A0B7E21}
AppName=CorridorKey
AppVersion=@APP_VERSION@
AppPublisher=EZ-CorridorKey fork (private build)
DefaultDirName={localappdata}\Programs\CorridorKey
DisableProgramGroupPage=yes
DisableDirPage=no
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=@OUT@
OutputBaseFilename=CorridorKey-{#VID}-windows-x86_64-setup
Compression=lzma2/fast
SolidCompression=no
DiskSpanning=yes
DiskSliceSize=max
UninstallDisplayIcon={app}\versions\{#VID}\bin\corridorkey-ui.exe
CloseApplications=no
DirExistsWarning=no

[Tasks]
Name: models; Description: "Download and verify ALL models now (very large; resumable). Without this, setup stays incomplete until you run corridorkey-setup models."; Flags: checkedonce

[Files]
Source: "@STAGE@\*"; DestDir: "{app}\versions\{#VID}"; Flags: recursesubdirs createallsubdirs ignoreversion

[UninstallRun]
; Removes shortcuts/shims/receipt and other versions; the running version's files go via UninstallDelete.
; Projects, outputs, models and settings are never touched.
Filename: "{app}\bin\corridorkey-setup.cmd"; Parameters: "uninstall --skip-running"; Flags: runhidden; RunOnceId: "CKUninstall"

[UninstallDelete]
; Only the exact version directory this installer created (pyc/log files Inno does not track live in it).
; Never {app}\versions or {app}\bin wholesale: a foreign file there must survive.
Type: filesandordirs; Name: "{app}\versions\{#VID}"
Type: dirifempty; Name: "{app}\versions"
Type: dirifempty; Name: "{app}\bin"
Type: dirifempty; Name: "{app}"

[Code]
{ The path goes into a quoted command line: a trailing backslash would escape the closing quote
  and a drive root cannot hold the install, so roots are rejected and other paths get no trailing slash. }
function IsDriveRoot(P: String): Boolean;
begin
  Result := (Length(RemoveBackslashUnlessRoot(P)) <= 3);
end;

function NextButtonClick(CurPageID: Integer): Boolean;
begin
  Result := True;
  if (CurPageID = wpSelectDir) and IsDriveRoot(WizardDirValue) then
  begin
    MsgBox('Choose a folder, not a drive root (for example D:\Apps\CorridorKey).', mbError, MB_OK);
    Result := False;
  end;
end;

var
  FailCode: Integer;

function GetCustomSetupExitCode: Integer;
begin
  Result := FailCode;  { nonzero => the setup process itself reports failure (Abort in ssPostInstall does not) }
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Py, Args, Models, AppDir: String;
  Rc, Rc2: Integer;
begin
  AppDir := RemoveBackslashUnlessRoot(ExpandConstant('{app}'));
  if CurStep = ssInstall then
  begin
    if IsDriveRoot(ExpandConstant('{app}')) then
    begin
      SuppressibleMsgBox('The install folder cannot be a drive root.', mbError, MB_OK, IDOK);
      FailCode := 5;
      Abort;
    end;
    { Files are laid down in place, so an identical existing build would be overwritten without a rollback
      path: refuse and point at repair/uninstall instead. }
    if DirExists(AppDir + '\versions\{#VID}') then
    begin
      SuppressibleMsgBox('This exact build is already installed. Run "corridorkey-setup repair" or uninstall it first.', mbError, MB_OK, IDOK);
      FailCode := 6;
      Abort;
    end;
  end;
  if CurStep <> ssPostInstall then exit;
  Py := AppDir + '\versions\{#VID}\runtime\python\python.exe';
  if WizardIsTaskSelected('models') then Models := 'full' else Models := 'skip';
  Args := '-I -B "' + AppDir + '\versions\{#VID}\app\packaging\lifecycle.py" --prefix "' + AppDir +
          '" install --version {#VID} --models ' + Models;
  { Visible console so model download progress is shown; the installer waits. }
  if not Exec(Py, Args, '', SW_SHOW, ewWaitUntilTerminated, Rc) then
    Rc := 2;
  if Rc = 3 then
    SuppressibleMsgBox('CorridorKey is installed but model setup is INCOMPLETE. Run "corridorkey-setup models" (or repair) to finish; affected workflows stay unavailable until then.', mbInformation, MB_OK, IDOK)
  else if Rc <> 0 then
  begin
    FailCode := Rc;
    { The failed version could not be deleted by the interpreter that ran from it; the previous version's
      setup shim (if any) finishes that cleanup now. }
    if FileExists(AppDir + '\bin\corridorkey-setup.cmd') then
      Exec(ExpandConstant('{cmd}'), '/c ""' + AppDir + '\bin\corridorkey-setup.cmd" recover"', '', SW_HIDE, ewWaitUntilTerminated, Rc2);
    SuppressibleMsgBox('Installation FAILED (code ' + IntToStr(Rc) + '): launch validation did not pass. The previous version (if any) stays active. See the console output.', mbError, MB_OK, IDOK);
  end;
end;
