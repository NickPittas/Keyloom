; Keyloom Windows ONLINE installer (Inno Setup 6). Rendered by packaging/bundle.py; do not edit the output.
; Per-user, no admin or automatic firewall rule, no account or sign-in. Activation configures the network host. This exe carries Keyloom itself
; (app, UI, FFmpeg, bundled Python and every small dependency) unpacked into {tmp} (deleted when Setup exits); online.py
; then downloads only the large public wheels (torch, triton, NVIDIA CUDA libraries) from PyPI / download.pytorch.org,
; reusing files of the installed versions, and hands the assembled payload to lifecycle.py (same transactional install as
; the full installer). No models here: download them from the app. Projects, settings, network identities and models are
; never touched. It is NOT uninstallable and registers no Add/Remove Programs entry (Uninstallable=no) with its own AppId,
; so it never replaces or breaks the full installer's entry; uninstall with "<prefix>\bin\keyloom-setup.cmd uninstall".
#define VID "@VERSION_ID@"

[Setup]
AppId={{E4A7B1C3-6D2F-4B8A-9C15-3F0D7A52E964}
AppName=Keyloom Online Setup
AppVersion=@APP_VERSION@
AppPublisher=Keyloom
SetupIconFile=@ICON@
CreateAppDir=no
Uninstallable=no
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=@OUT@
OutputBaseFilename=Keyloom-online-{#VID}-windows-x86_64
Compression=lzma2/fast
SolidCompression=no
DiskSpanning=yes
; 1900 MiB slices like the full installer: the exe and every -N.bin must sit in one folder.
DiskSliceSize=1992294400
DisableWelcomePage=yes
DisableDirPage=yes
DisableProgramGroupPage=yes
DisableReadyPage=yes
DisableFinishedPage=yes
SetupMutex=KeyloomOnlineSetupMutex
CloseApplications=no

[Tasks]
Name: firewall; Description: "Configure Windows Firewall rules for the network service (a Windows administrator prompt follows during setup)"

[Files]
; The minimal bundled Python (and the supervisor script) live in {tmp}\kb, OUTSIDE the payload that online.py assembles and
; moves; every Python step below runs from there. {tmp} is private to this Setup run and deleted when it exits.
Source: "@BOOT@\installer_payload.py"; DestDir: "{tmp}"; Flags: dontcopy
Source: "@BOOT@\*"; DestDir: "{tmp}\kb"; Flags: recursesubdirs createallsubdirs ignoreversion
Source: "@WRAP@\*"; DestDir: "{tmp}\k"; Flags: recursesubdirs createallsubdirs ignoreversion

[Code]
var
  FailCode: Integer;
  LogFile: String;  { <prefix>\install.log once the install folder is discovered }
  PreLog: String;   { %TEMP% log from the start of setup; AttachPreLog copies it into LogFile; kept afterwards }
  LogWriteFailed: Boolean;

function GetCustomSetupExitCode: Integer;
begin
  Result := FailCode;  { nonzero => the setup process itself reports failure }
end;

procedure LogLine(Msg: String);
var
  Line: String;
begin
  Line := GetDateTimeString('yyyy-mm-dd hh:nn:ss', '-', ':') + ' ' + Msg;
  if LogFile = '' then SaveStringToFile(PreLog, Line + #13#10, True)
  else if not SaveStringToFile(LogFile, Line + #13#10, True) then
  begin
    LogWriteFailed := True;
    SaveStringToFile(PreLog, Line + ' (install.log not writable: ' + LogFile + ')' + #13#10, True);
  end;
end;

procedure AttachPreLog;
var
  Pre: AnsiString;
begin
  ForceDirectories(ExtractFilePath(LogFile));
  if not LoadStringFromFile(PreLog, Pre) or not SaveStringToFile(LogFile, Pre, True) then LogWriteFailed := True;
end;

function LogHint: String;
begin
  Result := '';
  if LogWriteFailed then Result := ' Log: ' + PreLog;
end;

{ One supervised Python step in a VISIBLE console: installer_payload.py runs the command as its own process tree, prints a
  heartbeat every second, kills and reaps the tree after 300 s without any output (exit 124) and exports the private wait file path to it as
  KEYLOOM_WAIT_FILE (online.py creates it only around real downloads/consent). The path is inside Setup's private tmp folder. }
function RunPyV(Interp, Verb, StepName, Extra: String; var Rc: Integer): Boolean;
var
  IP, LogArg: String;
begin
  LogArg := ' --log "' + PreLog + '"';
  if LogFile <> '' then LogArg := ' --log "' + LogFile + '" --log-title "Keyloom {#VID} windows-online installer"';
  IP := ExpandConstant('{tmp}\installer_payload.py');  { extracted by InitializeSetup; the bootstrap copy is the fallback }
  if not FileExists(IP) then IP := ExpandConstant('{tmp}\kb\installer_payload.py');
  Result := Exec(Interp, '-I -B "' + IP + '" ' + Verb + ' --label ' + StepName + LogArg + Extra, '', SW_SHOW, ewWaitUntilTerminated, Rc);
  if not Result then
  begin
    LogLine('cannot start ' + Interp + ': ' + SysErrorMessage(Rc) + ' (' + IntToStr(Rc) + ')');
    Rc := 2;
  end;
end;

function RunPy(Interp, StepName, Cmd: String; var Rc: Integer): Boolean;
begin
  Result := RunPyV(Interp, 'run', StepName, ' --wait-file "' + ExpandConstant('{tmp}\waiting-for-user') + '" -- ' + Cmd, Rc);
end;

procedure ExitProcess(uExitCode: Cardinal); external 'ExitProcess@kernel32.dll stdcall';

{ Same build already installed and verified? Decided in InitializeSetup, BEFORE Inno unpacks the heavy payload: the installed, owned
  lifecycle checks the exact version id built into this setup (fast ordinary check: no runtime rehash, no engine import, no GPU
  probe), under the supervisor with a visible console. Candidate folder: /PREFIX, else the full installer's
  recorded folder (HKCU before HKLM), else the default; the authoritative `discover` run still happens later. A negative or
  failed probe simply continues to the normal install. Nothing is written. /REPAIR=1 skips it. }
function InitializeSetup: Boolean;
var
  P, S, Raw2, Py, Lc: String;
  Raw: AnsiString;
  Rc: Integer;
begin
  Result := True;
  PreLog := AddBackslash(GetEnv('TEMP')) + 'Keyloom-setup-{#VID}-' + GetDateTimeString('yyyymmdd-hhnnss', '', '') + '.log';
  if ExpandConstant('{param:REPAIR|0}') = '1' then exit;
  P := ExpandConstant('{param:PREFIX|}');
  if P = '' then
  begin
    Raw2 := 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{3F9A2C71-8E4B-4D6F-B1A5-7C0E92D4A6B3}_is1';
    if RegQueryStringValue(HKCU, Raw2, 'Inno Setup: App Path', S) or RegQueryStringValue(HKLM, Raw2, 'Inno Setup: App Path', S) then
      if DirExists(S) and FileExists(S + '\receipt.json') then P := S;
  end;
  if P = '' then P := ExpandConstant('{localappdata}\Programs\Keyloom');
  P := RemoveBackslashUnlessRoot(P);
  if not DirExists(P + '\versions\{#VID}') then exit;
  if not LoadStringFromFile(P + '\current.txt', Raw) then exit;
  Py := P + '\versions\' + Trim(String(Raw)) + '\runtime\python\python.exe';
  Lc := P + '\versions\' + Trim(String(Raw)) + '\app\packaging\lifecycle.py';
  if (Trim(String(Raw)) = '') or not FileExists(Py) or not FileExists(Lc) then exit;
  ExtractTemporaryFile('installer_payload.py');
  RunPyV(Py, 'run', 'check', ' -- "' + Py + '" -I -B "' + Lc + '" --prefix "' + P + '" check --version {#VID}', Rc);
  LogLine('fast check: ' + P + ' rc=' + IntToStr(Rc));
  if Rc = 0 then
  begin
    LogLine('already installed and verified; nothing was changed');
    SuppressibleMsgBox('Keyloom {#VID} is already installed and verified. Nothing was changed (settings, models and services are untouched). Use /REPAIR=1 to restore damaged files.', mbInformation, MB_OK, IDOK);
    ExitProcess(0);
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Boot, Prefix, Src, Args, Bpy, DiscFile, Reason: String;
  DiscLines: TArrayOfString;
  Rc: Integer;
begin
  { the install folder is discovered once, read-only, at ssPostInstall (see below) }
  if CurStep <> ssPostInstall then exit;
  Boot := ExpandConstant('{tmp}\k');
  Bpy := ExpandConstant('{tmp}\kb\python.exe');
  { ONE read-only discovery (HKCU/HKLM keys, then the recorded Keyloom folder's receipt.json, then the default; read by the bundled
    helper, precedence fixed in code: /PREFIX > recorded folder > default). No second Python process, no console per probe; nothing is written. }
  DiscFile := ExpandConstant('{tmp}\discovered.txt');
  DeleteFile(DiscFile);
  RunPyV(Bpy, 'discover', 'discover', ' --prefix-param "' + ExpandConstant('{param:PREFIX|}') + '" --out "' + DiscFile + '"', Rc);
  Reason := '';
  if Rc <> 0 then Reason := 'discover exited with code ' + IntToStr(Rc)
  else if not FileExists(DiscFile) then Reason := 'discover wrote no output file'
  else if not LoadStringsFromFile(DiscFile, DiscLines) then Reason := 'discover output file could not be read'
  else if GetArrayLength(DiscLines) < 1 then Reason := 'discover output file is empty';
  if Reason <> '' then
  begin
    FailCode := 14;
    LogLine('discover failed: ' + Reason);
    SuppressibleMsgBox('Setup could not determine the install folder: ' + Reason + '. Nothing was installed or changed.' + LogHint, mbError, MB_OK, IDOK);
    exit;
  end;
  Prefix := Trim(DiscLines[0]);
  Src := '';
  if GetArrayLength(DiscLines) > 1 then Src := Trim(DiscLines[1]);
  LogLine('install folder: ' + Prefix + ' (' + Src + ')');
  if Length(Prefix) <= 3 then
  begin
    FailCode := 5;
    LogLine('install folder is a drive root: ' + Prefix);
    SuppressibleMsgBox('The install folder cannot be a drive root (for example use D:\Apps\Keyloom).' + LogHint, mbError, MB_OK, IDOK);
    exit;
  end;
  LogFile := Prefix + '\install.log';
  AttachPreLog;
  Args := '"' + Bpy + '" -I -B "' + Boot + '\payload\app\packaging\online.py" --payload-dir "' + Boot + '\payload" --sources "' +
          Boot + '\wheel-sources.json" --prefix "' + Prefix + '"';
  if ExpandConstant('{param:REPAIR|0}') = '1' then Args := Args + ' --repair';
  if WizardIsTaskSelected('firewall') then Args := Args + ' --firewall yes' else Args := Args + ' --firewall skip';
  { online.py owns the reuse/attach decision. Visible, supervised console: heartbeat each second plus the client's real download/verify progress. }
  RunPy(Bpy, 'online', Args, Rc);
  if Rc = 0 then exit;
  FailCode := Rc;
  LogLine('Setup failed with code ' + IntToStr(Rc));
  if Rc = 124 then
    SuppressibleMsgBox('Keyloom setup STOPPED: a step showed no progress for 5 minutes and was ended. The previous install (if any) is unchanged.' + LogHint, mbError, MB_OK, IDOK)
  else if Rc = 4 then
    SuppressibleMsgBox('Keyloom is running. Quit it with File > Quit (a background network service does not need to be stopped) and run setup again. Nothing was changed.' + LogHint, mbError, MB_OK, IDOK)
  else if Rc = 130 then
    SuppressibleMsgBox('Setup was cancelled. The previous Keyloom install (if any) is unchanged.' + LogHint, mbInformation, MB_OK, IDOK)
  else
    SuppressibleMsgBox('Keyloom setup FAILED (code ' + IntToStr(Rc) + '). The previous install (if any) is unchanged. Run setup from a Command Prompt to keep the console output, then try again.' + LogHint, mbError, MB_OK, IDOK);
end;

procedure DeinitializeSetup;
begin
  LogLine('Setup finished with code ' + IntToStr(FailCode));
end;
